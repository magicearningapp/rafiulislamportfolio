rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio_content/{docId} {
      allow read, write: if true;
    }
    match /portfolio_projects/{projectId} {
      allow read, write: if true;
    }
    match /portfolio_photos/{photoId} {
      allow read, write: if true;
    }
    match /photo_reactions/{photoId} {
      allow read, write: if true;
    }
    match /photo_comments/{commentId} {
      allow read, write: if true;
    }
    match /pending_testimonials/{testimonialId} {
      allow read, write: if true;
    }
    match /project_inquiries/{inquiryId} {
      allow read, write: if true;
    }
  }
}
